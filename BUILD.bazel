load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
)

exports_files(["LICENSE.txt"])

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSL-1.0"],
    license_text = "LICENSE.txt",
)

# The library is defined beside its sources; these are its public names.

# Static library, without main: the Catch2-compatible engine, the Catch3
# runner, which replaced Catch2's session, command line and reporters,
# property testing and snapshots.
alias(
    name = "catch3",
    actual = "//src/Progmasoft:catch3",
    visibility = ["//visibility:public"],
)

# Static library, with main.
alias(
    name = "catch3_main",
    actual = "//src/Progmasoft:catch3_main",
    visibility = ["//visibility:public"],
)
