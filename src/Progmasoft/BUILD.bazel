load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# The Catch3 runner, built into //:catch2. It is C++20; Catch2's headers
# still need only C++14 in the code that includes them.
cc_library(
    name = "runner",
    srcs = glob(["Runner/*.cpp"]) + [
        "Results.cpp",
        "XmlWriter.cpp",
        "//:src/catch2/catch_session.cpp",
    ],
    hdrs = glob(["Runner/*.hpp"]) + [
        "Catch3/Results.hpp",
        "Catch3/Runner.hpp",
        "Catch3/Version.hpp",
        "Catch3/XmlWriter.hpp",
    ],
    copts = select({
        "@platforms//os:windows": ["/std:c++20"],
        "//conditions:default": ["-std=c++20"],
    }),
    linkstatic = True,
    strip_include_prefix = "/src",
    deps = ["//:catch2_core"],
)

cc_library(
    name = "catch3",
    srcs = [
        "ChoiceShrinker.cpp",
        "Context.cpp",
        "PropertyEngine.cpp",
        "Snapshot.cpp",
    ],
    hdrs = [
        "Catch3.hpp",
        "Catch3/Assertions.hpp",
        "Catch3/Detail/InvalidArgument.hpp",
        "Catch3/Detail/Sequence.hpp",
        "Catch3/ForAll.hpp",
        "Catch3/Generator.hpp",
        "Catch3/Generators/Boolean.hpp",
        "Catch3/Generators/Element.hpp",
        "Catch3/Generators/Integer.hpp",
        "Catch3/Generators/Text.hpp",
        "Catch3/Generators/Tuple.hpp",
        "Catch3/Generators/Vector.hpp",
        "Catch3/Property.hpp",
        "Catch3/Random.hpp",
        "Catch3/Relations.hpp",
        "Catch3/Snapshot.hpp",
        "Catch3/Stateful.hpp",
        "Catch3/Strategy/ChoiceSource.hpp",
        "Catch3/Strategy/Containers.hpp",
        "Catch3/Strategy/Context.hpp",
        "Catch3/Strategy/Engine.hpp",
        "Catch3/Strategy/Numeric.hpp",
        "Catch3/Strategy/Strategy.hpp",
    ],
    copts = select({
        "@platforms//os:windows": ["/std:c++20"],
        "//conditions:default": ["-std=c++20"],
    }),
    strip_include_prefix = "/src",
    deps = [
        "//:catch2",
    ],
)
